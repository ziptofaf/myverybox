# Copy to .env and fill in. Used by docker-compose.yml.

# Public URL of the app, used for share links returned by the API.
APP_HOSTNAME=https://myverybox.example.com

# Generate with: openssl rand -hex 64
# Keep it stable: changing it signs everyone out and invalidates file links
# generated by Active Storage.
SECRET_KEY_BASE=

POSTGRES_PASSWORD=
# POSTGRES_USER=myverybox
# POSTGRES_DB=myverybox_production

# Set to false to use the app over plain http (e.g. locally without a proxy).
# RAILS_FORCE_SSL=true

# Where the app is published on the host.
# WEB_BIND=127.0.0.1
# WEB_PORT=3000

# Keep uploaded files in a host directory instead of the `storage` volume
# (must be writable by uid 1000).
# STORAGE_PATH=/srv/myverybox/storage

# Puma worker processes.
# WEB_CONCURRENCY=2

# Use prebuilt images instead of building locally, e.g.
# WEB_IMAGE=ghcr.io/<owner>/myverybox:latest
# CLIPPY_IMAGE=ghcr.io/<owner>/myverybox-clippy:latest
