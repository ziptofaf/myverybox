<h1>System settings</h1>

<div class="ui grid">
  <% if flash[:notice] %>
    <div class="sixteen wide computer column">
      <p><%= flash[:notice] %></p>
    </div>
  <% end %>
  <div class="sixteen wide computer column">
    <h3 class="ui header">Storage</h3>
    <table class="ui definition table">
      <tbody>
        <tr>
          <td class="four wide">Database</td>
          <td><%= number_to_human_size(@database_bytes) %></td>
        </tr>
        <tr>
          <td>Uploaded files</td>
          <td>
            <%= number_to_human_size(@uploads.bytes) %> in <%= number_with_delimiter(@uploads.count) %> files
            <% if @uploads.expired_count.positive? %>
              <span class="ui grey text">(<%= number_to_human_size(@uploads.expired_bytes) %> of it in <%= number_with_delimiter(@uploads.expired_count) %> expired files)</span>
            <% end %>
          </td>
        </tr>
        <tr>
          <td>Thumbnails and previews</td>
          <td><%= number_to_human_size(@uploads.generated_bytes) %></td>
        </tr>
        <tr>
          <td>Disk holding uploaded files</td>
          <td>
            <% if @disk %>
              <strong><%= number_to_human_size(@disk.available_bytes) %> free</strong>
              of <%= number_to_human_size(@disk.total_bytes) %> (<%= @disk.used_percent %>% used)
              <div class="ui small progress <%= @disk.used_percent >= 90 ? 'error' : (@disk.used_percent >= 75 ? 'warning' : 'success') %>" style="margin: 0.5em 0 0">
                <div class="bar" style="width: <%= @disk.used_percent.clamp(0, 100) %>%; min-width: 0"></div>
              </div>
            <% else %>
              <span class="ui grey text">not available (files are not stored on a local disk)</span>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  
  <div class="twelve wide computer sixteen wide mobile column">
    <% if @expires_in_seconds && @remove_expired_files && @image_description_analysis %>
      <%= form_for :system_settings, url: system_settings_update_settings_path, method: :put, html: {class: 'ui form'} do |f| %>
        <div class="field">
          <%= f.label :expires_in_seconds, 'By default files expire in (seconds, set 0 for unlimited):' %>
          <%= f.number_field :expires_in_seconds, value: @expires_in_seconds.formatted_value %>
        </div>
       <div class="field">
         <%= f.label :remove_expired_files, 'Should expired files be automatically removed (daily task, NOT YET implemented)' %>
         <%= f.check_box :remove_expired_files, checked: @remove_expired_files.formatted_value %>
       </div>
        <div class="field">
          <%= f.label :image_description_analysis, 'Should image files be sent to image analysis after upload - descriptions and search by image content (requires the clippy service)' %>
          <%= f.check_box :image_description_analysis, checked: @image_description_analysis.formatted_value %>
        </div>
        <div class="field">
          <%= f.submit "Update settings", class: 'ui button primary' %>
        </div>
      <% end %>
    <% else %>
     <p>One of the settings is missing. Please make sure to run all the migrations!</p>
    <% end %>
  </div>
  

  <div class="twelve wide computer sixteen wide mobile column">
    <%= button_to 'Remove expired files', system_settings_clean_up_expired_file_uploads_path, method: :delete, class: 'ui red button', form: {data: {turbo_confirm: 'Are you sure?'}} %>
  </div>
  
  
</div>
